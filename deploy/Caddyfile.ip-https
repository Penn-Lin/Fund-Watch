# 阶段二：裸 IP + Let's Encrypt 短周期证书
#
# 由 deploy/setup.sh 自动把 __PUBLIC_IP__ 替换成真实公网 IP 后写入
# /etc/caddy/Caddyfile。手动改法：
#   sed 's/__PUBLIC_IP__/你的公网IP/' deploy/Caddyfile.ip-https > /etc/caddy/Caddyfile
#   systemctl reload caddy
#
# 前提：443 必须能从公网访问（LE 对 IP 只支持 TLS-ALPN-01 验证），
#      阿里云安全组入方向要放行 443。
#
# 证书 6 天有效，Caddy 每 2 天自动续。别删 /var/lib/caddy，
# 那里面是证书和 ACME 账号状态，删了要重申请，会撞 LE 限速。

# 关键：客户端用 IP 直连时浏览器/curl 都不发 SNI（RFC 6066 不允许 IP 字面量），
# Caddy 收不到 SNI 就没法挑证书，握手直接失败（SEC_E_ILLEGAL_MESSAGE）。
# 用 default_sni 兜底，让无 SNI 的连接也能拿到这张 IP 证书。
{
	default_sni __PUBLIC_IP__
}

__PUBLIC_IP__ {
	# IP 证书必须走 ACME 的短周期 profile（LE 对 IP 只签 6 天证书）。
	# 注意：Caddy 2.11 的写法是 issuer acme { profile ... }，
	# 不是 tls { profile ... }（后者会报 unknown subdirective）。
	tls {
		issuer acme {
			profile shortlived
		}
	}
	encode gzip zstd
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Real-IP {http.request.remote.host}
	}
	log {
		output file /var/log/caddy/fund-monitor.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

# 保底入口：万一证书签不下来（443 被拦 / LE 限速），
# 还能用 http://IP:8443 进来，不至于完全进不去。
:8443 {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Real-IP {http.request.remote.host}
	}
	log {
		output file /var/log/caddy/fund-monitor-8443.log {
			roll_size 10MiB
			roll_keep 2
		}
	}
}
